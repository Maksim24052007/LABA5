<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.number4calculator.CalculatorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="num1Field" promptText="Первое число"/>
    <ComboBox fx:id="operationCombo" promptText="Операция"/>
    <TextField fx:id="num2Field" promptText="Второе число"/>

    <Button text="Вычислить" onAction="#onCalculateButtonClick"/>

    <Label fx:id="resultLabel" text="Результат: "/>
</VBox>