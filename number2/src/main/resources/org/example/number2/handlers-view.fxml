<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>


<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TextField?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.number2.HandlersController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <CheckBox fx:id="btnCheckBox" text="Показать кнопку" selected="true"/>
    <Button fx:id="myButton" text="Кнопка из задания"/>

    <CheckBox fx:id="tfCheckBox" text="Показать поле ввода" selected="true"/>
    <TextField fx:id="myTextField" promptText ="Текстовое поле..."/>

    <CheckBox fx:id="lblCheckBox" text="Показать текст" selected="true"/>
    <Label fx:id="myLabel" text="Это обычный текст (Label)"/>
</VBox>
